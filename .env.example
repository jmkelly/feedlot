# Feedlot Configuration
# Copy this to .env and fill in your values

# Required: random secret for JWT token signing
FEEDLOT_JWT_SECRET=

# Recommended: 32-byte hex key for encrypting API keys at rest
FEEDLOT_ENCRYPTION_KEY=

# Optional: HTTP listen port (default: 8080)
# FEEDLOT_PORT=8080

# Optional: database path (default: ./feedlot.db)
# FEEDLOT_DB_PATH=./feedlot.db

# Optional: background feed refresh interval (default: 30m)
# FEEDLOT_REFRESH_INTERVAL=30m

# Optional: default API key for built-in OpenCode Go provider
# FEEDLOT_OPENCODE_GO_KEY=
